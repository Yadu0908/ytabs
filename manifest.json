{
  "manifest_version": 3,
  "name": "YTab Material You",
  "version": "1.6.0",
  "description": "A minimal, customizable new tab page.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "history",
    "favicon"
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "offline_enabled": true
}